{
  "name": "outspace-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "node scripts/gen-icons.mjs && vite build",
    "preview": "vite preview",
    "electron:build": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.outspace.player",
    "productName": "Outspace",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/tray-icon.png",
      "dist/**/*",
      "!node_modules/**",
      "!src/**",
      "!public/**",
      "!dist-electron/**"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "42.3.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
