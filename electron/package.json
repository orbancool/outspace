{
  "name": "outspace",
  "version": "1.0.0",
  "description": "Outspace — random music by genre",
  "main": "main.cjs",
  "author": "Outspace",
  "build": {
    "appId": "com.outspace.player",
    "productName": "Outspace",
    "directories": {
      "output": "../dist-electron",
      "buildResources": "build"
